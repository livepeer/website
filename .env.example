# The Graph (optional — falls back to hardcoded values)
THEGRAPH_API_KEY=

# Notion — the roadmap register (optional locally; without it /roadmap falls
# back to content/roadmap/*.md). Internal integration token, shared with both
# the "Roadmap commitments" and "Roadmap people" databases.
NOTION_TOKEN=

# Lets an agent that has just edited the roadmap in Notion push the change live
# immediately, instead of waiting out NOTION_REVALIDATE. Any long random string;
# the endpoint refuses to run when it is unset.
REVALIDATE_SECRET=

# Set by the Notion webhook handshake — POST the subscription from Notion's
# Webhooks tab, read verification_token out of the deployment logs, and put it
# here. It is the signing key for every event after it and is not recoverable
# later; re-subscribe to get a new one.
NOTION_WEBHOOK_SECRET=

# The changelog's headlines are written by a model when a month closes and
# stored in Notion (see lib/headline-draft.ts and /changelog/headline).
# On Vercel the model is reached through the AI Gateway with the
# deployment's own OIDC token, billed to the Vercel account, so no model
# key is needed there. Locally, `vercel env pull` writes a twelve-hour
# VERCEL_OIDC_TOKEN into .env.local. Either of these overrides that:
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# An integration token that can edit the Changelog entries database. The
# site's NOTION_TOKEN is read-only on purpose and stays that way.
NOTION_WRITE_TOKEN=
# Vercel sends this as a bearer token on the cron invocation; set it to
# any long random string.
CRON_SECRET=

# The Graph (optional — falls back to hardcoded values)
THEGRAPH_API_KEY=

# Notion — every Notion-backed surface (optional locally; without it the site
# falls back to the markdown in content/). Internal integration token, read-only,
# shared with the "Livepeer.org content" page so it reaches everything under
# it: Roadmap commitments, Roadmap updates, Livepeer people, Organizations,
# Blog posts, Funding paths, Changelog entries, Legal pages and the guides
# (Reporting on a commitment). Sharing it with only some of them makes the
# rest fail once the token is set, since a Notion failure with a token throws.
NOTION_TOKEN=

# Lets an agent that has just edited the roadmap in Notion push the change live
# immediately, instead of waiting out NOTION_REVALIDATE. Any long random string;
# the endpoint refuses to run when it is unset.
REVALIDATE_SECRET=

# Set by the Notion webhook handshake — POST the subscription from Notion's
# Webhooks tab, read verification_token out of the deployment logs, and put it
# here. It is the signing key for every event after it and is not recoverable
# later; re-subscribe to get a new one.
NOTION_WEBHOOK_SECRET=


# The Discord invite served when the server's widget cannot be read (widget
# off, outage, timeout). Optional; without it the site serves the invite the
# widget answered with on 2026-09-06. Must be a discord.gg or
# discord.com/invite URL, or it is ignored with a warning. NEXT_PUBLIC_ because
# the header's content carries it on the client too.
NEXT_PUBLIC_DISCORD_FALLBACK_INVITE=

# PostHog (instrumentation-client.ts). The project token is public: it ships
# in the browser bundle. Leave it empty and the site sends nothing to PostHog,
# which is what a clone and local dev should do. Set in Vercel for production.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Optional; defaults to PostHog's US host.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend — the footer's newsletter signup (app/api/newsletter). Server-only.
# The form only shows when both are set. The segment is the one the weekly
# send must include for signups to get the next issue.
RESEND_API_KEY=
RESEND_NEWSLETTER_SEGMENT_ID=
